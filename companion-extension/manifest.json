{
  "manifest_version": 3,
  "name": "LifeMirror Desktop",
  "version": "1.4.0",
  "description": "Companion extension for LifeMirror Desktop. Privately reflects active browsing time, smart tags, and page descriptions to your on-device timeline.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "contextMenus",
    "storage",
    "sidePanel",
    "idle"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "incognito": "not_allowed",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
