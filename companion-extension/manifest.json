{
  "manifest_version": 3,
  "name": "LifeMirror Desktop",
  "version": "1.0.0",
  "description": "Companion extension for LifeMirror Desktop. Pipes browser active tab events securely to the local SQLite engine.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
