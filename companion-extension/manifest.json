{
  "manifest_version": 3,
  "name": "LifeMirror Desktop",
  "version": "1.4.1",
  "minimum_chrome_version": "102",
  "description": "Companion for LifeMirror Desktop. Privately reflects active browsing time, smart tags, and page summaries to your local timeline.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "LifeMirror Desktop — Open Side Panel"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "contextMenus",
    "storage",
    "sidePanel",
    "idle"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "incognito": "not_allowed",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
