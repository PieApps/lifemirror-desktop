{
  "manifest_version": 3,
  "name": "LifeMirror Desktop",
  "version": "1.2.1",
  "description": "Companion extension for LifeMirror Desktop. Privately syncs active browser tabs to your personal on-device timeline.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
