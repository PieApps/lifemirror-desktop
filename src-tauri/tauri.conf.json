{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lifemirror-desktop",
  "version": "0.1.24",
  "identifier": "com.lifemirror.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LifeMirror Desktop",
        "width": 1200,
        "height": 768,
        "minWidth": 768,
        "minHeight": 500,
        "visible": false
      },
      {
        "label": "toast",
        "title": "Distraction Reminder",
        "url": "/toast",
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "width": 380,
        "height": 140,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "LifeMirror Desktop is a privacy-first, local productivity reflection tool.",
    "longDescription": "LifeMirror Desktop captures operating system activity logs and browser tab focus histories natively, records them securely in a local encrypted database, and visualizes your day as a winding timeline serpentine infographic. It processes logs using a locally running AI model (Ollama) to compile daily mindfulness cards entirely offline, ensuring no user data ever leaves your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "desktop.template"
      }
    }
  }
}
