{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeMirror Desktop Dev",
  "identifier": "com.lifemirror.desktop.dev",
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "dev-mcp",
          "description": "Capability for development MCP automation plugin",
          "windows": ["main", "overlay", "toast"],
          "permissions": [
            "mcp:default"
          ]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "LifeMirror Desktop (Dev)",
        "width": 1200,
        "height": 768,
        "minWidth": 768,
        "minHeight": 500,
        "visible": false
      },
      {
        "label": "toast",
        "title": "Distraction Reminder (Dev)",
        "url": "/toast",
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "width": 380,
        "height": 140,
        "resizable": false
      }
    ]
  }
}
